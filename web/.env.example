# Which chain this build talks to: 4663 = Robinhood Chain mainnet, 46630 = testnet, 31337 = local anvil.
NEXT_PUBLIC_CHAIN_ID=4663
# Optional: a private RPC (e.g. Alchemy). Falls back to the public RPC of the chain.
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (cloud.reown.com) for mobile wallets.
NEXT_PUBLIC_WC_PROJECT_ID=
# Project X account (defaults to https://x.com/orminefun).
NEXT_PUBLIC_X_URL=
