# Used by script/Deploy.s.sol. Never commit the real .env.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Owns both contracts. If it is not the deployer, it must call acceptOwnership on each after deploy.
OWNER=
# Receives the team share of mints and the royalties.
TREASURY=
# Wallet or bot allowed to swap vein ETH for stock.
KEEPER=
# Where NFT images live, ending with "/": https://<domain>/nft/ or ipfs://<cid>/
IMAGE_BASE=

# Deployer: pass with `--account <keystore name>` (cast wallet import) instead of a raw key.
