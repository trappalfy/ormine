{
  "name": "ormine",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "test:contracts": "cd contracts && forge test",
    "test:shared": "pnpm --filter @ormine/shared test",
    "check": "pnpm typecheck && pnpm lint && pnpm test:shared && pnpm test:contracts",
    "chain": "anvil --block-time 1",
    "deploy:local": "scripts/deploy-local.sh",
    "abi": "node scripts/export-abi.mjs"
  }
}
